# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24 / openssl rand -hex 32
LEASH_ADMIN_TOKEN=
LEASH_SECRET=
LEASH_DOMAIN=leash.example.com
# Optional: seed providers on start (you can also add them in the dashboard)
LEASH_ANTHROPIC_KEY=
LEASH_OPENAI_KEY=
LEASH_OPENAI_BASE_URL=https://api.openai.com/v1
